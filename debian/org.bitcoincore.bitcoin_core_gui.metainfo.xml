<component type="desktop-application">
  <id>org.bitcoincore.bitcoin_core_gui</id>
  <metadata_license>MIT</metadata_license>
  <project_license>MIT</project_license>
  <content_rating type="oars-1.0" />
  <name>Bitcoin Core</name>
  <summary>A Bitcoin node with graphical interface</summary>

  <description>
    <p>
      Bitcoin Core is a Bitcoin client and it builds the backbone of the 
      network. It downloads and, by default, stores the entire history of 
      Bitcoin transactions
    </p>
  </description>

  <launchable type="desktop-id">bitcoin-core-gui.desktop</launchable>

  <screenshots>
    <screenshot type="default">
      <caption>Preview</caption>
      <image>https://bitcoin.org/img/bitcoin-core/clear-overview.png</image>
    </screenshot>
  </screenshots>

  <url type="homepage">https://bitcoincore.org</url>
  <project_group>bitcoin</project_group>

  <provides>
    <binary>bitcoin-qt</binary>
  </provides>

  <releases>
    <release version="31.1" date="2026-07-02">
      <url>https://github.com/bitcoin/bitcoin/releases/tag/v31.1</url>
      <description>
        <p>See release notes on GitHub.</p>
      </description>
    </release>
  </releases>

  <developer id="org.bitcoincore">
    <name>The Bitcoin Core developers</name>
  </developer>

</component>