msgstr ""
"Maximale grootte van de gegevens bij transacties met gegevensdragers voor "
"doorsturen en minen, in bytes."

#. Type: note
#. Description
#: ../bitcoin-core.templates:27001
msgid "Bad value for datacarriersize."
msgstr "Slechte waarde voor datacarriersize."

#. Type: note
#. Description
#: ../bitcoin-core.templates:27001
msgid "datacarriersize must be superior or equal to 0."
msgstr "datacarriersize moet groter zijn dan of gelijk aan 0."

#. Type: error
#. Description
