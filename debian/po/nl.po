"bitcoin.conf."

#. Type: string
#. Description
#: ../bitcoin-core.templates:23001
msgid "Value for blockreconstructionextratxn:"
msgstr "Waarde voor blockreconstructionextratxn:"

#. Type: string
#. Description
#: ../bitcoin-core.templates:23001
msgid "Extra transactions to keep in memory for compact block reconstructions."
msgstr ""
"Extra transacties die in het geheugen moeten worden bewaard voor de "
"reconstructie van compacte blokken."

#. Type: note
#. Description
#: ../bitcoin-core.templates:24001
msgid "Bad value for blockreconstructionextratxn."
msgstr "Slechte waarde voor blockreconstructionextratxn."

#. Type: note
#. Description
#: ../bitcoin-core.templates:24001
msgid "blockreconstructionextratxn must be superior or equal to 0."
msgstr "blockreconstructionextratxn moet groter zijn dan of gelijk aan 0."

#. Type: error
#. Description
#: ../bitcoin-core.templates:25001
