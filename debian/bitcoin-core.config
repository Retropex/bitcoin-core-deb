#!/bin/sh
# Exit immediately if a command produces an error.
set -e
# Source debconf library
. /usr/share/debconf/confmodule

maybe_reset() {
    if [ "$1" = "reconfigure" ] || [ -n "$DEBCONF_RECONFIGURE" ]; then
        db_reset "$2" || true
    fi
}

ask_or_clear() {
    local priority="$1"
    local question="$2"
    db_input "$priority" "$question" || {
        db_fget "$question" seen || true
        if [ "$RET" != "true" ]; then
            db_set "$question" ""
        fi
    }
}

maybe_reset "$1" bitcoin-core/prune-bool
ask_or_clear medium bitcoin-core/prune-bool
db_go || true

db_get bitcoin-core/prune-bool || RET=
if [ "$RET" = "true" ];then
	maybe_reset "$1" bitcoin-core/prune
	ask_or_clear medium bitcoin-core/prune
	db_go || true
	
	db_get bitcoin-core/prune || RET=
	if [ "$RET" ]; then
		while true; do
		  if echo "$RET" | grep -sqE '^[0-9]+$' && { [ "$RET" -eq 0 ] || [ "$RET" -eq 1 ] || [ "$RET" -ge 550 ]; }; then
		    break
		  fi
		  db_input high bitcoin-core/prune-fail || true
		  db_go || true
		  db_input medium bitcoin-core/prune || true
		  db_go || true
		  db_get bitcoin-core/prune || RET=
		done
	fi
	unset RET
elif [ "$RET" = "false" ];then
	maybe_reset "$1" bitcoin-core/txindex
	ask_or_clear medium bitcoin-core/txindex
	db_go || true
fi
unset RET

maybe_reset "$1" bitcoin-core/datacarriersize
ask_or_clear medium bitcoin-core/datacarriersize
db_go || true

db_get bitcoin-core/datacarriersize || RET=
if [ "$RET" ]; then
	while true; do
	if echo "$RET" | grep -sqE '^[0-9]+$' && [ "$RET" -ge 0 ]; then
		break
	fi
	db_input high bitcoin-core/datacarriersize-wrong || true
	db_go || true
	db_input medium bitcoin-core/datacarriersize || true
	db_go || true
	db_get bitcoin-core/datacarriersize || RET=
	done
fi
unset RET

maybe_reset "$1" bitcoin-core/dbcache
ask_or_clear medium bitcoin-core/dbcache
db_go || true

db_get bitcoin-core/dbcache || RET=
if [ "$RET" ]; then
	while true; do
	if echo "$RET" | grep -sqE '^[0-9]+$' && [ "$RET" -ge 4 ]; then
		break
	fi
	db_input high bitcoin-core/dbcache-wrong || true
	db_go || true
	db_input medium bitcoin-core/dbcache || true
	db_go || true
	db_get bitcoin-core/dbcache || RET=
	done
fi
unset RET

maybe_reset "$1" bitcoin-core/rpcthreads
ask_or_clear low bitcoin-core/rpcthreads
db_go || true

db_get bitcoin-core/rpcthreads || RET=
if [ "$RET" ]; then
	while true; do
	if echo "$RET" | grep -sqE '^[0-9]+$' && [ "$RET" -ge 0 ]; then
		break
	fi
	db_input high bitcoin-core/rpcthreads-wrong || true
	db_go || true
	db_input low bitcoin-core/rpcthreads || true
	db_go || true
	db_get bitcoin-core/rpcthreads || RET=
	done
fi
unset RET

maybe_reset "$1" bitcoin-core/rpcworkqueue
ask_or_clear low bitcoin-core/rpcworkqueue
db_go || true

db_get bitcoin-core/rpcworkqueue || RET=
if [ "$RET" ]; then
	while true; do
	if echo "$RET" | grep -sqE '^[0-9]+$' && [ "$RET" -ge 0 ]; then
		break
	fi
	db_input high bitcoin-core/rpcworkqueue-wrong || true
	db_go || true
	db_input low bitcoin-core/rpcworkqueue || true
	db_go || true
	db_get bitcoin-core/rpcworkqueue || RET=
	done
fi
unset RET

maybe_reset "$1" bitcoin-core/blockmaxweight
ask_or_clear low bitcoin-core/blockmaxweight
db_go || true

db_get bitcoin-core/blockmaxweight || RET=
if [ "$RET" ]; then
	while true; do
	if echo "$RET" | grep -sqE '^[0-9]+$' && { [ "$RET" -ge 0 ] && [ "$RET" -le 3985000 ] ; }; then
		break
	fi
	db_input high bitcoin-core/blockmaxweight-wrong || true
	db_go || true
	db_input low bitcoin-core/blockmaxweight || true
	db_go || true
	db_get bitcoin-core/blockmaxweight || RET=
	done
fi
unset RET

maybe_reset "$1" bitcoin-core/maxmempool
ask_or_clear low bitcoin-core/maxmempool
db_go || true

db_get bitcoin-core/maxmempool || RET=
if [ "$RET" ]; then
	while true; do
	if echo "$RET" | grep -sqE '^[0-9]+$' && [ "$RET" -ge 5 ]; then
		break
	fi
	db_input high bitcoin-core/maxmempool-wrong || true
	db_go || true
	db_input low bitcoin-core/maxmempool || true
	db_go || true
	db_get bitcoin-core/maxmempool || RET=
	done
fi
unset RET

maybe_reset "$1" bitcoin-core/blockreconstructionextratxn
ask_or_clear low bitcoin-core/blockreconstructionextratxn
db_go || true

db_get bitcoin-core/blockreconstructionextratxn || RET=
if [ "$RET" ]; then
	while true; do
	if echo "$RET" | grep -sqE '^[0-9]+$' && [ "$RET" -ge 0 ]; then
		break
	fi
	db_input high bitcoin-core/blockreconstructionextratxn-wrong || true
	db_go || true
	db_input low bitcoin-core/blockreconstructionextratxn || true
	db_go || true
	db_get bitcoin-core/blockreconstructionextratxn || RET=
	done
fi
unset RET